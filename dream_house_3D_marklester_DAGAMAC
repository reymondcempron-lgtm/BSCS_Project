def switch_day_night():

    global is_night

    is_night = not is_night

    if is_night:

        Sky(color=color.rgb(15, 20, 50))

        sun.color = color.rgb(80, 80, 120)

        ambient.color = color.rgba(
            50, 50, 100, 255
        )

        title_text.color = GOLD

    else:

        Sky(color=SKY_BLUE)

        sun.color = color.white

        ambient.color = color.rgba(
            150, 150, 150, 255
        )

        title_text.color = color.white



def input(key):

    if key == "n":

        switch_day_night()

    if key == "escape":

        mouse.locked = not mouse.locked

        player.cursor.visible = not mouse.locked

    if key == "e":

        mouse.locked = True

        player.cursor.visible = False

    if key == "q":

        application.quit()



def update():

    player.x = max(-25, min(player.x, 25))

    player.z = max(-25, min(player.z, 25))

    if player.y < -5:

        player.position = (0, 2, -12)

