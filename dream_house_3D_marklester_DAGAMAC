def make_cube(name, position, scale, color_value,
              rotation=(0, 0, 0), collider=None):

    return Entity(
        name=name,
        model="cube",
        position=position,
        scale=scale,
        color=color_value,
        rotation=rotation,
        collider=collider
    )



