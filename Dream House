# BSCS_Project
Dream House Using Vpython in 3d from vpython import *

# Dream House - Simple 3D Two-Storey House
scene = canvas(
    title="Dream House Using VPython in 3D",
    width=1000, height=700,
    background=vector(0.55, 0.78, 0.98)
)
scene.center = vector(0, 3, 0)
scene.camera.pos = vector(12, 9, 18)
scene.camera.axis = scene.center - scene.camera.pos
scene.autoscale = False
scene.range = 13

# Colors
wall = vector(0.92, 0.90, 0.84)
trim = vector(0.25, 0.28, 0.33)
glass = vector(0.35, 0.72, 0.92)
wood = vector(0.40, 0.22, 0.10)
roof_color = vector(0.20, 0.22, 0.27)
grass = vector(0.25, 0.62, 0.28)

# Ground and yard
box(pos=vector(0, -0.15, 0), size=vector(30, 0.3, 30), color=grass)
box(pos=vector(0, 0.02, 5.5), size=vector(2.3, 0.08, 8), color=vector(0.68, 0.68, 0.65))

# Main first-floor walls
box(pos=vector(0, 1.5, 0), size=vector(8, 3, 0.35), color=wall)
box(pos=vector(-4, 1.5, 2), size=vector(0.35, 3, 4), color=wall)
box(pos=vector(4, 1.5, 2), size=vector(0.35, 3, 4), color=wall)
box(pos=vector(0, 1.5, 4), size=vector(8, 3, 0.35), color=wall)

# Second floor
box(pos=vector(0, 4.5, 0), size=vector(8, 3, 0.35), color=wall)
box(pos=vector(-4, 4.5, 2), size=vector(0.35, 3, 4), color=wall)
box(pos=vector(4, 4.5, 2), size=vector(0.35, 3, 4), color=wall)
box(pos=vector(0, 4.5, 4), size=vector(8, 3, 0.35), color=wall)

# Flat roof
box(pos=vector(0, 6.15, 2), size=vector(9, 0.3, 5), color=roof_color)

# Front door (front is toward negative z)
box(pos=vector(1.9, 1.15, -0.24), size=vector(1.25, 2.3, 0.12), color=wood)
sphere(pos=vector(2.32, 1.1, -0.33), radius=0.07, color=vector(0.95, 0.78, 0.25))

# Ground-floor front window
box(pos=vector(-1.5, 1.7, -0.24), size=vector(2.0, 1.45, 0.12), color=trim)
box(pos=vector(-1.5, 1.7, -0.32), size=vector(1.78, 1.23, 0.05), color=glass)
box(pos=vector(-1.5, 1.7, -0.36), size=vector(0.07, 1.23, 0.04), color=trim)
box(pos=vector(-1.5, 1.7, -0.36), size=vector(1.78, 0.07, 0.04), color=trim)

# Second-floor front window
box(pos=vector(-1.0, 4.7, -0.24), size=vector(2.5, 1.5, 0.12), color=trim)
box(pos=vector(-1.0, 4.7, -0.32), size=vector(2.28, 1.28, 0.05), color=glass)
box(pos=vector(-1.0, 4.7, -0.36), size=vector(0.07, 1.28, 0.04), color=trim)
box(pos=vector(-1.0, 4.7, -0.36), size=vector(2.28, 0.07, 0.04), color=trim)

# Balcony floor and railing
box(pos=vector(-0.8, 3.15, -1.0), size=vector(5.5, 0.18, 1.7), color=trim)
for x in [-3.35, -2.5, -1.65, -0.8, 0.05, 0.9, 1.75]:
    cylinder(pos=vector(x, 3.22, -1.75), axis=vector(0, 0.8, 0), radius=0.045, color=trim)
cylinder(pos=vector(-3.35, 4.0, -1.75), axis=vector(5.1, 0, 0), radius=0.06, color=trim)
cylinder(pos=vector(-3.35, 3.65, -1.75), axis=vector(5.1, 0, 0), radius=0.04, color=trim)

# Front steps
for i in range(3):
    box(pos=vector(1.5, 0.18 + i*0.22, -0.7 - i*0.38),
        size=vector(2.0, 0.25, 0.75), color=vector(0.68, 0.68, 0.66))

# Small bushes
for x, z in [(-3.4, -2.5), (-2.7, -3.1), (3.6, -2.4), (3.0, -3.0)]:
    sphere(pos=vector(x, 0.45, z), radius=0.48, color=vector(0.12, 0.45, 0.16))

# Simple trees
for x, z in [(-7, 1), (7, 2)]:
    cylinder(pos=vector(x, 0.9, z), axis=vector(0, 1.8, 0), radius=0.18, color=wood)
    sphere(pos=vector(x, 2.7, z), radius=1.0, color=vector(0.12, 0.48, 0.15))
    sphere(pos=vector(x-0.45, 2.5, z+0.1), radius=0.65, color=vector(0.16, 0.55, 0.18))
    sphere(pos=vector(x+0.45, 2.9, z-0.1), radius=0.65, color=vector(0.18, 0.52, 0.16))

# Labels
label(pos=vector(0, 7.0, 0), text="MY DREAM HOUSE", height=22,
      box=False, color=color.white, opacity=0)

scene.append_to_caption("\\nDrag the mouse to rotate the 3D view. Scroll to zoom in/out.")
