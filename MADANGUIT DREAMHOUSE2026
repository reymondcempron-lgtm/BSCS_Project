# 21. PLAYER AND MOVEMENT
# ==================================================
player_speed = 0.18
turn_speed = 0.08

keys = {
    "w": False,
    "s": False,
    "a": False,
    "d": False,
    "left": False,
    "right": False
}

# Initial player location outside house
scene.camera.pos = vector(0, 1.8, -16)
scene.camera.axis = vector(0, 0, 1)


def key_down(event):
    key = event.key.lower()

    if key in keys:
        keys[key] = True

    # First floor view
    if key == "1":
        scene.camera.pos = vector(0, 1.8, 0)
        scene.camera.axis = vector(0, 0, 1)

    # Second floor view
    elif key == "2":
        scene.camera.pos = vector(0, 5.0, 0)
        scene.camera.axis = vector(0, 0, 1)

    # Reset outside
    elif key == "0":
        scene.camera.pos = vector(0, 1.8, -16)
        scene.camera.axis = vector(0, 0, 1)


def key_up(event):
    key = event.key.lower()

    if key in keys:
        keys[key] = False


scene.bind("keydown", key_down)
scene.bind("keyup", key_up)

# ==================================================
# 22. INSTRUCTIONS
# ==================================================
instructions = label(
    pos=vector(0, 9, 0),
    text=(
        "REAJOY DREAM HOUSE\n"
        "WASD = Move | LEFT/RIGHT = Turn\n"
        "1 = First Floor | 2 = Second Floor\n"
        "0 = Return Outside"
    ),
    height=16,
    box=True,
    color=WHITE,
    background=vector(0.1, 0.1, 0.2),
    opacity=0.8
)

# ==================================================
# 23. MOVEMENT LOOP
# ==================================================
while True:
    rate(60)

    forward = vector(
        scene.camera.axis.x,
        0,
        scene.camera.axis.z
    )

    if mag(forward) > 0:
        forward = norm(forward)

    right = norm(cross(forward, vector(0, 1, 0)))

    movement = vector(0, 0, 0)

    if keys["w"]:
        movement += forward * player_speed

    if keys["s"]:
        movement -= forward * player_speed

    if keys["a"]:
        movement -= right * player_speed

    if keys["d"]:
        movement += right * player_speed

    # Move camera
    new_pos = scene.camera.pos + movement

    # Keep camera inside the environment
    new_pos.x = max(-25, min(25, new_pos.x))
    new_pos.z = max(-22, min(22, new_pos.z))

    scene.camera.pos = new_pos

    # Rotate camera left and right
    if keys["left"]:
        scene.camera.axis = rotate(
            scene.camera.axis,
            angle=turn_speed,
            axis=vector(0, 1, 0)
        )

    if keys["right"]:
        scene.camera.axis = rotate(
            scene.camera.axis,
            angle=-turn_speed,
            axis=vector(0, 1, 0)
        )
