def make_box(pos, size, color, opacity=1):
    return box(
        pos=vector(*pos),
        size=vector(*size),
        color=color,
        opacity=opacity
    )


def make_tree(x, z, height=4):
    # Tree trunk
    cylinder(
        pos=vector(x, 0, z),
        axis=vector(0, height * 0.55, 0),
        radius=0.22,
        color=BROWN
    )

    # Leaves
    sphere(
        pos=vector(x, height * 0.75, z),
        radius=height * 0.35,
        color=GREEN
    )

    sphere(
        pos=vector(x - 0.5, height * 0.65, z),
        radius=height * 0.25,
        color=DARK_GREEN
    )

    sphere(
        pos=vector(x + 0.5, height * 0.70, z),
        radius=height * 0.25,
        color=GREEN
    )


def make_flower(x, z, flower_color):
    cylinder(
